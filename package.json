{
  "name": "create-pubsub",
  "version": "2.0.0",
  "description": "A tiny Event Emitter and Observable Store.",
  "type": "module",
  "files": [
    "main",
    "react",
    "immer"
  ],
  "types": "./main/index.d.ts",
  "main": "./main/index.js",
  "exports": {
    ".": {
      "types": "./main/index.d.ts",
      "default": "./main/index.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./immer": {
      "types": "./immer/index.d.ts",
      "default": "./immer/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "del main react immer && rollup -c && npx tsc --emitDeclarationOnly --declaration --outDir .temp-types && mv .temp-types/src/main/index.d.ts main/ && mv .temp-types/src/react/index.d.ts react/ && mv .temp-types/src/immer/index.d.ts immer/ && rm -rf .temp-types",
    "test": "node --import tsx --import global-jsdom/register --test test/**/*.ts test/**/*.tsx",
    "test-watch": "watchlist test -- npm test",
    "prepare": "package-check && npm run build",
    "preview-package-contents": "npm pack --dry-run",
    "postbuild": "node --input-type=module -e \"await import('./main/index.js'); await import('./immer/index.js'); await import('./react/index.js')\"",
    "size-check": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felladrin/create-pubsub.git"
  },
  "keywords": [
    "event",
    "events",
    "dispatcher",
    "emitter",
    "listener",
    "listeners",
    "event-emitter",
    "subscribe",
    "state",
    "state-management"
  ],
  "author": {
    "name": "Victor Nogueira",
    "email": "victor@victornogueira.app",
    "url": "https://victornogueira.app"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/felladrin/create-pubsub/issues"
  },
  "homepage": "https://github.com/felladrin/create-pubsub#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "@skypack/package-check": "0.2.2",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "del-cli": "7.0.0",
    "global-jsdom": "30.0.0",
    "immer": "11.1.18",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "4.63.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "size-limit": "13.0.3",
    "tslib": "2.8.1",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "watchlist": "0.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "immer": ">=9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "immer": {
      "optional": true
    }
  }
}
